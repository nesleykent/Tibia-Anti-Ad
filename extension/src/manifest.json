  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "26.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tibia-props.js"
      ],
      "matches": [
        "*://www.twitch.tv/*"
      ]
    }
  ]
