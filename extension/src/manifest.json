{
  "manifest_version": 3,
  "name": "Tibia Anti-Ad",
  "version": "1.7.1",
  "description": "Blocks ads, trackers and anti-adblock walls on Twitch and 15 Tibia fansites: network rules, cosmetic fixes, Source quality and stitched video ad removal on Twitch. Every feature and site has its own switch.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Tibia Anti-Ad — Blocking enabled",
    "default_icon": {
      "16": "icons/safari-toolbar/active-16.png",
      "19": "icons/safari-toolbar/active-19.png",
      "32": "icons/safari-toolbar/active-32.png",
      "38": "icons/safari-toolbar/active-38.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html"
  },
  "background": {
    "scripts": [
      "sites.js",
      "settings.js",
      "tibia-evidence.js",
      "tibia-classify.js",
      "tibia-rules.js",
      "background.js"
    ]
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*",
    "*://exevopan.com/*",
    "*://*.exevopan.com/*",
    "*://forum.portaltibia.com.br/*",
    "*://*.forum.portaltibia.com.br/*",
    "*://guildstats.eu/*",
    "*://*.guildstats.eu/*",
    "*://hakaimarket.com/*",
    "*://*.hakaimarket.com/*",
    "*://hunt-analyser.com/*",
    "*://*.hunt-analyser.com/*",
    "*://intibia.com/*",
    "*://*.intibia.com/*",
    "*://portaltibia.com.br/*",
    "*://*.portaltibia.com.br/*",
    "*://tibia.fandom.com/*",
    "*://*.tibia.fandom.com/*",
    "*://tibialife.com.br/*",
    "*://*.tibialife.com.br/*",
    "*://tibiamonk.com/*",
    "*://*.tibiamonk.com/*",
    "*://tibiapal.com/*",
    "*://*.tibiapal.com/*",
    "*://tibiaring.com/*",
    "*://*.tibiaring.com/*",
    "*://tibiavip.app/*",
    "*://*.tibiavip.app/*",
    "*://tibiawiki.com.br/*",
    "*://*.tibiawiki.com.br/*",
    "*://tibiopedia.pl/*",
    "*://*.tibiopedia.pl/*",
    "https://raw.githubusercontent.com/*",
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "twitch_ads",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "twitch_tracking",
        "enabled": true,
        "path": "tracking.json"
      },
      {
        "id": "site_exevopan_com",
        "enabled": true,
        "path": "sites/exevopan.com.json"
      },
      {
        "id": "site_forum_portaltibia_com_br",
        "enabled": true,
        "path": "sites/forum.portaltibia.com.br.json"
      },
      {
        "id": "site_guildstats_eu",
        "enabled": true,
        "path": "sites/guildstats.eu.json"
      },
      {
        "id": "site_hakaimarket_com",
        "enabled": true,
        "path": "sites/hakaimarket.com.json"
      },
      {
        "id": "site_hunt_analyser_com",
        "enabled": true,
        "path": "sites/hunt-analyser.com.json"
      },
      {
        "id": "site_intibia_com",
        "enabled": true,
        "path": "sites/intibia.com.json"
      },
      {
        "id": "site_portaltibia_com_br",
        "enabled": true,
        "path": "sites/portaltibia.com.br.json"
      },
      {
        "id": "site_tibia_fandom_com",
        "enabled": true,
        "path": "sites/tibia.fandom.com.json"
      },
      {
        "id": "site_tibialife_com_br",
        "enabled": true,
        "path": "sites/tibialife.com.br.json"
      },
      {
        "id": "site_tibiamonk_com",
        "enabled": true,
        "path": "sites/tibiamonk.com.json"
      },
      {
        "id": "site_tibiapal_com",
        "enabled": true,
        "path": "sites/tibiapal.com.json"
      },
      {
        "id": "site_tibiaring_com",
        "enabled": true,
        "path": "sites/tibiaring.com.json"
      },
      {
        "id": "site_tibiavip_app",
        "enabled": true,
        "path": "sites/tibiavip.app.json"
      },
      {
        "id": "site_tibiawiki_com_br",
        "enabled": true,
        "path": "sites/tibiawiki.com.br.json"
      },
      {
        "id": "site_tibiopedia_pl",
        "enabled": true,
        "path": "sites/tibiopedia.pl.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*",
        "*://exevopan.com/*",
        "*://*.exevopan.com/*",
        "*://forum.portaltibia.com.br/*",
        "*://*.forum.portaltibia.com.br/*",
        "*://guildstats.eu/*",
        "*://*.guildstats.eu/*",
        "*://hakaimarket.com/*",
        "*://*.hakaimarket.com/*",
        "*://hunt-analyser.com/*",
        "*://*.hunt-analyser.com/*",
        "*://intibia.com/*",
        "*://*.intibia.com/*",
        "*://portaltibia.com.br/*",
        "*://*.portaltibia.com.br/*",
        "*://tibia.fandom.com/*",
        "*://*.tibia.fandom.com/*",
        "*://tibialife.com.br/*",
        "*://*.tibialife.com.br/*",
        "*://tibiamonk.com/*",
        "*://*.tibiamonk.com/*",
        "*://tibiapal.com/*",
        "*://*.tibiapal.com/*",
        "*://tibiaring.com/*",
        "*://*.tibiaring.com/*",
        "*://tibiavip.app/*",
        "*://*.tibiavip.app/*",
        "*://tibiawiki.com.br/*",
        "*://*.tibiawiki.com.br/*",
        "*://tibiopedia.pl/*",
        "*://*.tibiopedia.pl/*"
      ],
      "js": [
        "sites.js",
        "settings.js",
        "settings-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "css": [
        "hide.css"
      ],
      "css_origin": "user",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "nags.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.twitch.tv/*"
      ],
      "js": [
        "tibia-props.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.twitch.tv/*"
      ],
      "js": [
        "sites.js",
        "settings.js",
        "tibia-evidence.js",
        "tibia-classify.js",
        "tibia-rules.js",
        "tibia-filter.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://exevopan.com/*",
        "*://*.exevopan.com/*"
      ],
      "css": [
        "sites/exevopan.com.css"
      ],
      "css_origin": "user",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://forum.portaltibia.com.br/*",
