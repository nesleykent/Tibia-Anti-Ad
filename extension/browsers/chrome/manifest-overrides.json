{
  "_comment": "Merged over ../extension/manifest.json by tools/build_chrome_extension.py.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms"
  ],
  "browser_specific_settings": null,
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Tibia Anti-Ad — Blocking enabled",
    "default_icon": {
      "16": "icons/chrome-toolbar/active-16.png",
      "32": "icons/chrome-toolbar/active-32.png",
      "48": "icons/chrome-toolbar/active-48.png",
      "128": "icons/chrome-toolbar/active-128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
