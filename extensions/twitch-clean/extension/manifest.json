{
  "manifest_version": 3,
  "name": "Twitch Clean",
  "version": "1.1.0",
  "description": "Blocks Twitch ad and tracking servers, hides display ads and prompts, forces Source quality, strips stitched video ads (vaft) and hides non-Tibia streams in the Tibia category. Every feature has its own switch.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Twitch Clean",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html"
  },
  "background": {
    "scripts": [
      "settings.js",
      "background.js"
    ]
  },
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "twitch_ads",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "twitch_tracking",
        "enabled": true,
        "path": "tracking.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "settings.js",
        "settings-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "css": [
        "hide.css"
      ],
      "css_origin": "user",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "js": [
        "nags.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.twitch.tv/*"
      ],
      "js": [
        "tibia-props.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.twitch.tv/*"
      ],
      "js": [
        "settings.js",
        "tibia-evidence.js",
        "tibia-classify.js",
        "tibia-filter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "26.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tibia-props.js"
      ],
      "matches": [
        "*://www.twitch.tv/*"
      ]
    }
  ]
}
