  "weights": {
    "_comment": "Points each signal adds to its side. *_fuzzy: one edit away (two for names of 10+ letters, at the lower *_far weight).",
    "title": 4,
    "title_fuzzy": 3.25,
    "title_far": 2.5,
    "world": 3,
    "command": 3,
    "pattern": 4,
    "tag": 3.5,
    "tag_fuzzy": 2.75,
    "channel": 1.5,
    "screen_ui": 6,
    "screen": 3,
    "screen_fuzzy": 2.5,
    "official_title": 4,
    "official_global": 3,
    "official_bracketed": 3.5,
    "official_fuzzy": 3,
    "official_tag_world": 3,
    "official_tag": 3,
    "model": 3,
    "model_tibia": 2
  },
  "decision": {
    "threshold": 3,
    "margin": 2,
    "stale_tags": 0.4,
    "_comment": "stale_tags multiplies official tags when the title names a server and no official world: tags are often stale or generic."
  },
