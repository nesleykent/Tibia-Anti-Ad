  "context": {
    "_comment": "Weak signals: weights below the threshold, so they only add to other evidence. Patterns are regular expressions on normalized text.",
    "other": [
      {
        "label": "server rates",
        "weight": 1.5,
        "pattern": "(?<![a-z0-9])(?:(?:exp|xp|rates?|stages?)\\s*(?:x\\s?(?:[3-9]|\\d{2,4})|(?:[3-9]|\\d{2,4})\\s?x)|(?:x\\s?(?:[3-9]|\\d{2,4})|(?:[3-9]|\\d{2,4})\\s?x)\\s*(?:exp|xp|rates?))(?![a-z0-9])"
      },
      {
        "label": "old client version",
        "weight": 1.5,
        "pattern": "(?<![0-9.])(?:7\\.[0-9]{1,2}|8\\.[0-9]{1,2}|10\\.[0-9]{2})(?![0-9.])"
      },
      {
        "label": "OT",
        "weight": 1.5,
        "pattern": "(?<![a-z0-9])(?:ot|ots|otsy|otsow|otzinho|otzinhos)(?![a-z0-9])"
      },
      {
        "label": "new or custom server",
        "weight": 1.5,
        "pattern": "(?<![a-z0-9])(?:(?:servidor|server|serv)\\s+(?:novo|new|custom|proprio|war)|(?:novo|new|custom)\\s+(?:servidor|server))(?![a-z0-9])"
      },
      {
        "label": "!ip command",
        "weight": 1.5,
        "pattern": "[!❗❕]ip(?![a-z0-9])"
      },
      {
        "label": "Pokémon",
        "weight": 2,
        "pattern": "(?<![a-z0-9])(?:pokemons?|poke|pokes|shiny|pokedex|pokebola|pokeball|pikachu|charizard)(?![a-z0-9])"
      },
      {
        "label": "idle game",
        "weight": 2,
        "pattern": "(?<![a-z0-9])idle(?![a-z0-9])"
      }
    ],
    "tibia": [
      {
        "label": "official site or feature",
        "weight": 1.5,
        "pattern": "(?<![a-z0-9])(?:tibia\\.com|tibiadrome|char bazaar)(?![a-z0-9])"
      }
    ],
